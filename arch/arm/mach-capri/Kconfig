config LITTLE_MODE
        bool "Little Memory Controller Mode"
        help
          Support the Little mode.

config LITTLE_MEMC_QOS
        bool "Enable Memory Controller QOS in Little Mode"
        depends on LITTLE_MODE
        help
          Enable Memory Controller QOS in Little mode.

config SUSPEND_INVALID
	bool "Set Suspend Invalid"
	depends on SUSPEND
	help
	  Make kernel to advertise all suspend states as invalid.

config IPC
	bool "Inter-Processor Communication (IPC)"
	default n
	help
	  Support for IPC.

config MAP_SDMA
	bool "MAP SDMA"
	default n
        select PL330 if (MAP_SDMA)
        select MAP_DMA_MMAP
	help
	  Support for the SDMA driver.
