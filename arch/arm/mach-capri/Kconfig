	depends on MAP_SDMA
	default n
	help
	  Support for the SDMA driver in secure mode.

config MAP_DMA_MMAP
	bool "MAP Memory Map utilities"
	default n
	help
	  Support for memory map utilities to prepare memory for DMA.

